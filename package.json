{
  "name": "dsh-plugin-writing-guard",
  "version": "2.0.1",
  "description": "Scientific writing & document integrity guard for AI-assisted research - prompt-guided argument economy with deterministic scientific, delivery, journal, and Word integrity checks.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src/word_guard",
    "skills",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node tests/run-tests.mjs",
    "postinstall": "node scripts/install-extras.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmutfyh/dsh-plugin-writing-guard.git"
  },
  "homepage": "https://github.com/xmutfyh/dsh-plugin-writing-guard#readme",
  "bugs": {
    "url": "https://github.com/xmutfyh/dsh-plugin-writing-guard/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "academic-writing",
    "scientific-writing",
    "research-paper",
    "ai-writing",
    "scientific-integrity",
    "journal-fit",
    "deepseek-harness",
    "docx",
    "microsoft-word",
    "ooxml",
    "document-integrity",
    "document-processing",
    "manuscript",
    "proofreading"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
