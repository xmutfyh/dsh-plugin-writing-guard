{
  "name": "dsh-plugin-writing-guard",
  "version": "0.9.2",
  "description": "Deterministic manuscript integrity guard for AI-assisted academic revision — protects scientific facts, claim strength (causal & evidential axes), negation, null findings, scope, citations and author style during polishing, while flagging mechanical AI writing (Scholarship Lock + Epistemic Lock; writing_audit / writing_rules / writing_style_profile; local, zero network, zero LLM)",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node tests/run-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmutfyh/dsh-plugin-writing-guard.git"
  },
  "homepage": "https://github.com/xmutfyh/dsh-plugin-writing-guard#readme",
  "bugs": {
    "url": "https://github.com/xmutfyh/dsh-plugin-writing-guard/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "host-plugin",
    "academic-writing",
    "paper",
    "manuscript",
    "writing-style",
    "ai-detection",
    "defensive-writing",
    "proofreading",
    "reviewer"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
