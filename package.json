{
  "name": "dsh-plugin-writing-guard",
  "version": "1.8.0",
  "description": "DeepSeek Harness (DSH) academic writing guard for papers — 论文去AI味 / AI-writing style detection, evidence preservation, journal-fit calibration, manuscript proofreading, writing_audit & automatic checks. Word document safe editing (三线表, scope edit). Local, zero network, zero LLM.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src/word_guard",
    "skills",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node tests/run-tests.mjs",
    "postinstall": "node scripts/install-extras.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmutfyh/dsh-plugin-writing-guard.git"
  },
  "homepage": "https://github.com/xmutfyh/dsh-plugin-writing-guard#readme",
  "bugs": {
    "url": "https://github.com/xmutfyh/dsh-plugin-writing-guard/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "host-plugin",
    "academic-writing",
    "scientific-writing",
    "paper-writing",
    "paper",
    "manuscript",
    "writing-style",
    "ai-detection",
    "ai-writing",
    "llm-writing",
    "defensive-writing",
    "scientific-integrity",
    "evidence-based-writing",
    "journal-fit",
    "proofreading",
    "reviewer"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
